{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter test:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter pub get)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(dart run tool/demo.dart:*)",
      "Bash(dart run .claude/hooks/rules_check.dart:*)",
      "Bash(make format)",
      "Bash(make analyze)",
      "Bash(make rules)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make demo)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(flutter pub add:*)",
      "Bash(flutter pub remove:*)",
      "Bash(flutter create:*)",
      "Bash(uv add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./models/**)",
      "Read(./android/key.properties)",
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart run \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.dart\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dart run \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_files.dart\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dart run \"$CLAUDE_PROJECT_DIR/.claude/hooks/format_on_edit.dart\""
          },
          {
            "type": "command",
            "command": "dart run \"$CLAUDE_PROJECT_DIR/.claude/hooks/rules_check.dart\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dart run \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests_on_stop.dart\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
